# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contractos
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=replace_this_with_a_very_long_random_secret_string
JWT_EXPIRES_IN=24h

# AWS (fill in after AWS account setup)
AWS_REGION=ap-southeast-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=contractos-files
AWS_SES_FROM_EMAIL=noreply@contractos.my

# Stripe (fill in after Stripe account setup)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
